# Configuración del Generador de Tráfico

# Distribución utilizada: uniforme o zipf
TRAFICO_DISTRIBUCION=uniforme

# Cantidad total de solicitudes a generar
TRAFICO_SOLICITUDES=1000

# Semilla para reproducibilidad
TRAFICO_SEMILLA=42

# Parámetro de la distribución Zipf
TRAFICO_ZIPF_S=1.2

# Solicitudes generadas por segundo
TRAFICO_TASA_ARRIBO=10